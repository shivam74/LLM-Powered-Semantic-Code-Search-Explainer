MONGODB_URI=mongodb://mongodb:27017/llm_code_search
JWT_SECRET_KEY=your_super_secret_jwt_key_here

# ── LLM providers (at least one required) ────────────────────────────────────
# Groq is recommended: free, extremely fast, no rate limits for typical usage.
# Get a key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token is required for embeddings (sentence-transformers via HF API)
# Get a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional — only needed if you want to use OpenAI as the LLM backend
OPENAI_API_KEY=

# ── Hybrid retrieval tuning ───────────────────────────────────────────────────
# Weights for RRF fusion. Must sum to 1.0.
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# Candidates fetched from each backend before fusion
RETRIEVAL_CANDIDATE_K=20

# Final results returned after fusion (and reranking if enabled)
RETRIEVAL_TOP_K=5

# ── Optional features ─────────────────────────────────────────────────────────
# Cross-encoder reranking via HuggingFace API (BAAI/bge-reranker-base).
# Improves ranking quality at the cost of ~300-500ms extra latency.
ENABLE_RERANKER=false

# LLM-generated one-sentence summaries appended to each chunk during indexing.
# Improves recall for abstract queries. Adds ~50ms per chunk during upload.
ENABLE_LLM_ENRICHMENT=false
